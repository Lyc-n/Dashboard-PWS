# Salin file ini menjadi `.env` lalu isi nilainya. `.env` sudah masuk .gitignore.
# Jangan pernah memberi awalan VITE_ pada variabel secret: prefix itu ikut
# ter-bundle ke browser (lihat envPrefix di vite.config.ts).

# --- Server-only ---

# Koneksi Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/NAMA_DB

# Kunci base64 untuk menandatangani session JWT (dipakai jose).
# Buat dengan: openssl rand -base64 32
SECRET_KEY=

# PIN login global. Satu PIN untuk seluruh pengguna, bukan akun per petugas.
PIN=

# --- Browser (VITE_ = ikut ter-bundle) ---

# Opsional. Dipakai src/lib/supabase-storage.ts untuk unggah foto.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=